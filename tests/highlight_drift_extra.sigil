#!spec   # a mode line with a trailing comment (lint: SGL001), still the mode line
#% daemon in-process   # the system's kind
#& header { address: a/b }
#&probe one two
  #& route ~{
    path: "/a}"            # a brace in a string is text
    nested { deep }
  } tail
--- Core ---
[Api] -> [Store] : put({Row})  #& after code: a comment
state {Job} { + -<Go>-> Run }
state [Worker] {
  + -> Idle
  Idle -<Task>-> Busy
  Busy -> Idle
}
state {Ticket} {
  + -<open>-> Open
  Open -<close,expire, drop>-> Closed   # a trigger list, one comma unspaced
  Closed -<close, expire>-> Closed
}
[Desk] @inv routes({Ticket}.state ∈ {Open, Closed})
[Desk] -> [Store] : {open, closed}
# sets standing in a statement: values, never data glyphs (no node)
branch on {Ticket}.state ∈ {Open, Closed} {
  yes => [Desk]
  _   => [Store]
}
loop @while {Ticket}.state ∈ {Open, Closed} {
  [Desk] -> [Store]
}
[Desk] ?> {Ticket}.state ∈ {Open,Closed} -> [Store]
{Ticket}, {Row} -> [Desk]
