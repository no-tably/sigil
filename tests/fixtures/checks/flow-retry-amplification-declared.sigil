#!craft
# SGC102 retry-amplification — a retry budget on the outermost retrying call.
# expect: 9:SGC111
# expect: 9:SGC163
# expect: 10:SGC111
# expect: 11:SGC111
# expect: 11:SGC201

(U) -> [A] : run() ×3 @inv retry-budget(10%)
[A] -> [B] : call() ×3
[B] -> (Ext) : op x.write() ×2 @timeout(1s) @after(1s)
