[
 {"name": "flat map", "text": "a: 1\nb: two words\n", "expect": {"a": "1", "b": "two words"}},
 {"name": "nested map", "text": "palette:\n  bg: '#000'\n  fg: \"#fff\"\nui:\n  text: $fg\n", "expect": {"palette": {"bg": "#000", "fg": "#fff"}, "ui": {"text": "$fg"}}},
 {"name": "three levels and dedent", "text": "a:\n  b:\n    c: 1\n  d: 2\ne: 3\n", "expect": {"a": {"b": {"c": "1"}, "d": "2"}, "e": "3"}},
 {"name": "crlf line endings", "text": "a: 1\r\nb:\r\n  c: 2\r\n", "expect": {"a": "1", "b": {"c": "2"}}},
 {"name": "leading BOM", "text": "\ufeffa: 1\n", "expect": {"a": "1"}},
 {"name": "no trailing newline", "text": "a: 1", "expect": {"a": "1"}},
 {"name": "blank and comment-only lines", "text": "# head\n\na: 1\n   \n  # indented comment\nb: 2\n", "expect": {"a": "1", "b": "2"}},
 {"name": "tab-indented comment line is skipped", "text": "a: 1\n\t# note\n", "expect": {"a": "1"}},
 {"name": "trailing comment after a value", "text": "a: red # the colour\n", "expect": {"a": "red"}},
 {"name": "hash without whitespace is not a comment", "text": "a: x#y\n", "expect": {"a": "x#y"}},
 {"name": "hash at line start", "text": "#a: 1\nb: 2\n", "expect": {"b": "2"}},
 {"name": "hash inside double quotes", "text": "a: \"x # y\"  # real\n", "expect": {"a": "x # y"}},
 {"name": "hash inside single quotes", "text": "a: 'x # y' # real\n", "expect": {"a": "x # y"}},
 {"name": "apostrophe in a plain value is not a quote", "text": "a: it's # gone\n", "expect": {"a": "it's"}},
 {"name": "trailing spaces and tabs dropped", "text": "a: v \t \n", "expect": {"a": "v"}},
 {"name": "double-quoted JSON escapes", "text": "a: \"tab\\there \\u00e9 \\\\ end\"\n", "expect": {"a": "tab\there \u00e9 \\ end"}},
 {"name": "escaped double quote does not end the string", "text": "a: \"say \\\"hi\\\" # not a comment\"\n", "expect": {"a": "say \"hi\" # not a comment"}},
 {"name": "bad double-quoted escape", "text": "a: \"\\q\"\n", "expect": "error"},
 {"name": "unterminated double quote", "text": "a: \"open\n", "expect": "error"},
 {"name": "text after a double-quoted value", "text": "a: \"x\" y\n", "expect": "error"},
 {"name": "single-quoted doubled quote", "text": "a: 'it''s'\n", "expect": {"a": "it's"}},
 {"name": "single-quoted doubled quote before a hash", "text": "a: 'it''s # kept' # dropped\n", "expect": {"a": "it's # kept"}},
 {"name": "single-quoted key with doubled quote", "text": "'it''s': v\n", "expect": {"it's": "v"}},
 {"name": "double-quoted key with colon", "text": "\"a: b\": c\n", "expect": {"a: b": "c"}},
 {"name": "unterminated single quote", "text": "a: 'open\n", "expect": "error"},
 {"name": "text after a closing single quote", "text": "a: 'x' y\n", "expect": "error"},
 {"name": "quoted empty value is not a map", "text": "a: ''\nb: \"\"\n", "expect": {"a": "", "b": ""}},
 {"name": "empty value without children", "text": "a:\nb: 1\n", "expect": {"a": "", "b": "1"}},
 {"name": "empty value at end of file", "text": "a: 1\nb:\n", "expect": {"a": "1", "b": ""}},
 {"name": "empty value with deeper lines is a map", "text": "a:\n    b: 1\n", "expect": {"a": {"b": "1"}}},
 {"name": "colon needs a following space", "text": "url: http://x.y/z\n", "expect": {"url": "http://x.y/z"}},
 {"name": "colon without space is not a key", "text": "a:b\n", "expect": "error"},
 {"name": "line without a colon", "text": "just text\n", "expect": "error"},
 {"name": "tab in the indent", "text": "a:\n\tb: 1\n", "expect": "error"},
 {"name": "tab after spaces in the indent", "text": "a:\n  \tb: 1\n", "expect": "error"},
 {"name": "no-break space in the indent", "text": "a:\n\u00a0 b: 1\n", "expect": "error"},
 {"name": "duplicate top-level key", "text": "a: 1\na: 2\n", "expect": "error"},
 {"name": "duplicate key after a map", "text": "a:\n  b: 1\na: 2\n", "expect": "error"},
 {"name": "duplicate nested key", "text": "a:\n  b: 1\n  b: 2\n", "expect": "error"},
 {"name": "same key in sibling maps is fine", "text": "a:\n  k: 1\nb:\n  k: 2\n", "expect": {"a": {"k": "1"}, "b": {"k": "2"}}},
 {"name": "empty plain key", "text": ": v\n", "expect": "error"},
 {"name": "empty quoted key", "text": "\"\": v\n", "expect": "error"},
 {"name": "empty single-quoted key", "text": "'': v\n", "expect": "error"},
 {"name": "block list", "text": "a:\n  - x\n", "expect": "error"},
 {"name": "bare dash", "text": "-\n", "expect": "error"},
 {"name": "flow sequence line", "text": "[a, b]\n", "expect": "error"},
 {"name": "flow map line", "text": "{a: 1}\n", "expect": "error"},
 {"name": "inconsistent indentation", "text": "a:\n    b: 1\n  c: 2\n", "expect": "error"},
 {"name": "deeper line under a scalar", "text": "a: 1\n  b: 2\n", "expect": "error"},
 {"name": "top-level key not at column 0", "text": "  a: 1\n", "expect": "error"},
 {"name": "proto-like keys are plain keys", "text": "__proto__: x\nconstructor: y\ntoString:\n  z: 1\n", "expect": {"__proto__": "x", "constructor": "y", "toString": {"z": "1"}}},
 {"name": "values are strings", "text": "n: 42\nb: true\nz: null\n", "expect": {"n": "42", "b": "true", "z": "null"}},
 {"name": "empty document", "text": "", "expect": {}},
 {"name": "comments only", "text": "# nothing\n\n", "expect": {}}
]
