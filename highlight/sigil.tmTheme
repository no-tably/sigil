    <dict>
      <key>name</key>
      <string>Keyword / storage</string>
      <key>scope</key>
      <string>keyword, storage, storage.type, storage.modifier, keyword.control</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#ff7b72</string>
      </dict>
    </dict>

    <dict>
