      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#f85149</string>
      </dict>
    </dict>

    <dict>
      <key>name</key>
      <string>Markup heading</string>
      <key>scope</key>
      <string>markup.heading</string>
      <key>settings</key>
      <dict>
