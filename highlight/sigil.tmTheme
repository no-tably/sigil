        <string>#d2a8ff</string>
      </dict>
    </dict>

    <dict>
      <key>name</key>
      <string>Type / class</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, entity.other.inherited-class, support.type, support.class</string>
      <key>settings</key>
      <dict>
