        <string>#f0883e</string>
      </dict>
    </dict>

    <dict>
      <key>name</key>
      <string>Variable</string>
      <key>scope</key>
      <string>variable, variable.other, meta.definition.variable entity.name.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#c9d1d9</string>
      </dict>
    </dict>

    <dict>
      <key>name</key>
      <string>Markup tag (HTML/XML) + attribute</string>
      <key>scope</key>
      <string>entity.name.tag</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#7ee787</string>
      </dict>
    </dict>

    <dict>
      <key>name</key>
      <string>Attribute name</string>
      <key>scope</key>
