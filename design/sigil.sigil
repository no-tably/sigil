#!sketch
#% job in-process
# sigil's toolchain: one package, one direction only:
# text -> tokens -> document -> scene -> runs -> findings / drawings / exports.
# Each expansion is a layer (a subpackage); a layer calls only the layers above
# it. One parser: Core's walk is the one reading of sigil text, and every reader takes
# its lines, statements and tokens from it. Some readers still re-scan the text the walk
# hands them (lint's modifier, payload and permission rules, kit's modifier text,
# highlight's payloads and branch interiors, scene's op and return, systems' tight(),
# inv's `@inv` text, check's SGC004 prose): the cleanup list, each to move into Core.
# One command, `sigil`, with a subcommand per tool (and one debug entry in Core, below).
# `#% job` is a simplification: the live view, `frames follow` and `highlight --stream`
# loop until stopped (daemon-shaped); the kind keeps the ending rules of the one-shot commands.
# Drawn: every flow between units, and each part's main calls in its unit. A part's other
# imports inside its own unit are named in a comment on it, not drawn: each drawn call is
# walked once per caller, and this model's happy run ends at default limits (a test pins it).
# Structural changes are modelled here before they are built (CLAUDE.md, 2026-10-20).

--- who uses it ---

# the people and programs that run `sigil` are drawn inside [Cli], at the command each
# one runs: the agent that follows the skill is the main user (craft, refine, check, export).
# The skill asks the user the system's kind once (`#%`); it never writes one to quiet a finding

(Visitor) -> [Playground] : play({Text}) => {Drawing}
# accepts: shared-writable-store — a person and the agent take turns on one file; sigil never writes it
|Source|                                            # the .sigil file: a person or the agent writes it, sigil only reads it
(Author) -> |Source| : edit({Text})                 # the live view redraws on a save
(Agent) -> |Source| : edit({Text})                  # craft and refine write the spec

--- trust boundaries: what crosses each ---

# dialect: Python code named by --dialect NAME|PATH or $SIGIL_DIALECT (the default), found
#   on $SIGIL_DIALECT_PATH or as ../sigil-NAME; executed in every command but themes (lint,
#   check, view, export, frames, highlight) and on each `--stream` {"dialect"} request read
#   from stdin (prepasses, strips, tokenizers, `#&` declarations, rules, rule packs)
# themes: YAML from themes/ or $SIGIL_THEME_PATH, or a PATH; values are strings, no code
#   or the theme a loaded dialect names (THEME), read the same way: still data, no code
# source: the .sigil file (or stdin), read by Cli, the live view (polled) and frames; never written
# export folder: written and deleted under the manifest rule (below, Publish)
# hosts: argv on a spawned `sigil`; the split's control file, in a private directory follow
#   checks before it reads (owner, mode), names the argv `sigil view` runs; follow writes its
#   heartbeat there and removes the directory on exit
# Pyodide: the visitor's text only; no files, no dialect, no export

--- the one entry point: flags in, one layer called, output out ---

# each command imports its layer only when it runs; every one but themes takes --dialect
[Cli] := {
  (Agent) -> [LintCmd] : craft({Argv}) => {Findings}          # after each change: lint --deep
  (Agent) -> [ViewCmd] : refine({Argv}) => {Reading}          # --sim all, --structure, --once views
  (Agent) -> [CheckCmd] : ready({Argv}) => {Findings}         # check --mode spec --export before an export
  (Agent) -> [ExportCmd] : export({Argv}) => {Delta}          # export --out DIR; --mermaid --spine when refining
  (Author) -> [ViewCmd] : watch({Argv}) => {Drawing}          # a person at a terminal: the live view
  (Host) -> [FramesCmd] : frames({Argv}) => {Frames}          # the Claude Code mod and pi (the agent's viewer tool)
  (Host) -> [HighlightCmd] : source({Argv}) => {Runs}        # construct's spec pane; any host that shows a .sigil file
  (Editor) -> [HighlightCmd] : edit({Lines}) => {Runs}       # --stream: one live process; a changed line range in, its runs out (JSON lines); {theme} and {dialect} requests switch them
  (Dialect) -> [LintCmd] : run({Argv}) => {Diagnostics}       # a dialect's wrapper: cli.main(argv, dialect=NAME), any command
  [LintCmd] -> [Analyse] : lint({Text}) => {Diagnostics}      # sigil lint (--deep also runs check)
  [CheckCmd] -> [Analyse] : check({Text}) => {Findings}       # sigil check (--limit, --budget, --overlaps, --export, --all-rules)
  [ViewCmd] -> [Present] : draw({Text}) => {Drawing}          # sigil view (live, --once, --sim, --structure)
  [ExportCmd] -> [Publish] : export({Text}) => {Delta}        # sigil export (--out DIR --name --limit, or --mermaid [--spine])
  [FramesCmd] -> [Present] : frames({Text}) => {Frames}       # sigil frames draw (packed rows for the hosts, --limit)
  [ThemesCmd] -> [Present] : theme({Name}) => {Palette}       # sigil themes
  [HighlightCmd] -> [Present] : highlight({Text}) => {Runs}  # sigil highlight FILE|- (--json: each line's runs, role and colour; else ANSI)
  # accepts: shared-writable-store — split by file: the host writes control.json, follow only .alive (and removes both on exit)
  [Follow] -> |Control| : read({Argv}) => {Argv}              # sigil frames follow CONTROL: polled, a change restarts the view; refused if another user owns it or can write it
  [Follow] -> |Control| : beat({Pid})                         # CONTROL.alive, every second: the host sees the split is live
  [Follow] -> |Control| : remove({Path})                      # on exit: CONTROL, .alive, the zellij layout, the private directory
  [Follow] ~> [ViewCmd] : spawn({Argv})                       # a child `sigil view` with that argv (--dialect included)
  (Host) -> |Control| : write({Argv})                         # $TMPDIR/sigil-view-XXXXXXXXXX/control.json (mktemp -d: 0700, the file 0600), the split's request
}

[Cli] -> |Source| : read({Path}) => {Text}          # FILE, or - for stdin: every command's text
[Cli] -> [Core] : dialect({Name}) => {Hooks}        # every command's --dialect
# round 9: limits start from the document's `#%` line and --limit is laid over them (a flag
# wins, raised or lowered); Model makes the one merge (sim.limits_for) for check, the export
# gate, view and frames, so a host's `frames draw` runs the document's limits with no flag
[Cli] -> [Model] : limits({Argv}) => {Limits}       # --limit pairs, validated by the sim's own parser, merged over the document's
# round 9: `sigil --version` prints sigil's one version constant (sigil.__version__); a test
# keeps it equal to plugin/meta.json, which packaging reads
[Cli] -> [Analyse] : diagnose({Text}) => {Findings}
[Cli] -> [Present] : draw({Text}) => {Drawing}
[Cli] -> [Present] : highlight({Text}) => {Runs}
[Cli] -> [Publish] : export({Text}) => {Delta}
[Playground] -> [Present] : frames({Doc}) => {Frames}     # Pyodide imports the package, less NOT_IN_PLAYGROUND
[Playground] -> [Analyse] : diagnose({Doc}) => {Findings} # check budget CHECK_RUNS
[Playground] -> [Core] : parse({Text}) => {Doc}           # the visitor's text, autoclosed
[Playground] -> [Model] : run({Scene}) => {Trace}         # the scenario list and the player's scene

--- the spine: each layer calls only the layers above it ---

[Model] -> [Core] : parse({Text}) => {Doc}
[Analyse] -> [Core] : parse({Text}) => {Doc}
[Analyse] -> [Model] : explore({Scene}) => {Trace}
[Publish] -> [Core] : parse({Text}) => {Doc}
[Publish] -> [Model] : systems({Doc}) => {Spine}
[Publish] -> [Analyse] : ready({Doc}) => {Gate}
[Present] -> [Core] : parse({Text}) => {Doc}
[Present] -> [Model] : run({Scene}) => {Trace}
[Present] -> [Analyse] : findings({Doc}) => {Findings}

--- the layers ---

# text in, one document out. Core's walk is the one reading of sigil text; pure but for
# the dialect load, and the debug entry `python3 -m sigil.core.dialects [NAME]`, which
# loads a dialect and prints its name
[Core] := {
  [Parse] -> [Read] : walk({Text}) => {Statements}            # one reading: lines, statements, tokens (line and column)
  [Parse] -> [Graph] : build({Statements}) => {Doc}            # nodes, wires, trees, blocks, gaps, header_only
  [Read] -> [Lex] : tokens({Line}) => {Tokens}                 # lex, vocab, tokens: the bracket and arrow tables
  [Read] -> [Dialects] : hooks({Name}) => {Hooks}              # prepasses, strips, tokenizers, `#&` declarations
  [Read] -> [Kinds] : kind({Line}) => {Kind}                   # the `#%` line after the mode line: shape, reach, concurrency, limits (round 9)
  # round 7: a glyph name never holds a comma: `{a, b}` is a set (a value: Lex's set token,
  # no node), wherever it stands; a data expansion's bare names are its shape:
  # `{Doc} := { path, text, note? }` (field names, `?` optional, a glyph for a nested shape;
  # no types), carried on the Doc as shapes
  # not drawn (imports in Core): Parse and Comments call Lex's lexicon, modifier scan and
  # line tests; Lex reads a dialect's tokenizer hooks (the dialect Dialects loaded); Lex and
  # Read build Graph's Node, and Graph reads Lex's bracket table
  [Lex]
  # a comment-only line whose `#` sits under the previous line's trailing `#`
  # continues that comment (its node's note); `# accepts:` never continues
  [Comments] -> [Graph] : notes({Doc}) => {Notes}              # notes and `# accepts:` (scene, check, kit, export read them)
  [Dialects] -> (Dialect) : load({Path}) => {Hooks}            # imports Python: the widest trust boundary
  # Kinds: a table, no rules. Shape service|library|daemon|job, reach networked|in-process,
  # concurrency concurrent|deterministic; no line = the first of each (checks as before).
  # Each word names the rule groups it turns off: library entry+traffic, job traffic,
  # daemon ending, in-process network, deterministic concurrency; the Doc carries the Kind
  # (round 8: read once, on the Walk and the Graph). Round 9: a `name=N` word on the line is
  # a limit (`#% daemon frames=300000`): Kinds keeps the pairs as written, in order, and
  # knows only their form; which names exist and what they bound is Model's (Program)
  [Kinds]
}

# what the design means and how it runs; pure
[Model] := {
  [Scene] -> [Core] : parse({Text}) => {Doc}                   # wires, roles, notes, joins, access, writers
  [Sim] -> [Scene] : scene({Doc}) => {Scene}
  # Systems: an expansion written at the top for a member of another unit nests
  # under that unit; an actor makes no system dependency and is never no-home;
  # a component first written at the top stays homed at the top.
  # Homes (0.6.4): a level that names a part only in its flows is never its home when
  # another level declares it (any level, not only an enclosing one); with no
  # declaration anywhere the outer level still homes it (never homeless).
  # A branch's or loop's subject is a read (0.6.9): a level naming a part only so is none
  # of its systems; a part every level names only so is no component.
  # The root (0.6.4): a top-level service named as the top (by slug), rooting a tree or owning an expansion, is the top
  # (one system, its members homed at the top), never a second system beside it.
  # Dependencies (0.6.4): a flow whose payload names a homed data glyph makes both
  # ends' systems depend on that glyph's system, as a flow to it does
  [Systems] -> [Scene] : edges({Doc}) => {Spine}               # the export model: systems, homes (a flow-only reference is no home; never homeless), interfaces
  [Structure] -> [Systems] : units({Doc}) => {Spine}           # `view --structure`: units, cycles, up, edge, reach
  [Structure] -> [Sim] : canonical({Doc}) => {Scene}           # writers per store, as check counts them (it builds that scene itself: not drawn)
  # the run: deterministic, no values computed
  [Sim] := {
    # Starts in a state (0.6.5): a scenario part `Owner=State` begins that owner's machine
    # in State (any state its block names, reached or not); parts combine with `+` as
    # Entry@t does, so every reader of a scenario name takes it. Listed: one per state
    # with a way out other than the initial one, after the overlaps, within the scenario limit
    [Scenarios] -> [Engine] : run({Scenario}) => {Trace}        # happy, deviations, overlaps (Entry@t), starts in a state (Owner=State)
    [Scenarios] -> [Narration] : tell({Trace}) => {Steps}        # beats, the log, run events
    [Engine] -> [Program] : compile({Scene}) => {Units}          # units, machines, triggers
    # Program: default frames and activations limits are max(floor, k × nodes+edges)
    # (k 128 / 20, sim.sized); a given limit is used as given. Given, in order: the
    # document's `#%` limits, then --limit over them (round 9, limits_for; each limit
    # remembers where it came from: default, scaled, document or flag). Scenarios and
    # Narration read its records and limits too (not drawn).
    # the replay rule is the sim's (0.6.8, sim.replayed): a start's replayed events are marked
    # on the run, said as replayed in log and narration, and SGC203 reads the mark (no rule of its own)
    [Program]
  }
}

# diagnosis: lint (form) and checks (meaning), in two records: lint's Diagnostic (Core's
# vocab) and check's Finding; they meet only as text lines (lint --deep)
[Analyse] := {
  # rules over the walk's lines, statements and tokens, and a dialect's lint rules; some
  # still re-scan a line's text (modifiers, `<-`, the SGL095 race, payloads, permissions)
  # round 7: a set as a flow's end, a bare name outside a data expansion, a field written twice
  # on the kind line: an unknown word, two words of one choice, a `#%` not after the
  # mode line; `deterministic` beside `parallel @any` or a `&?` race (a claim the design breaks)
  # round 9: a limit on the kind line that the sim's parser refuses (an unknown name, a value
  # below 1, not NAME=N), or one limit named twice; the message is --limit's own: Lint calls
  # Model's validator, the one --limit uses (not drawn: a call into Model walks its whole run)
  [Lint] -> [Core] : read({Text}) => {Statements}
  # the work cap: 400 frames × max(budget, 256), counted over the overlap runs only
  [Check] -> [Core] : parse({Text}) => {Doc}
  [Check] -> [Model] : explore({Scene}) => {Trace}             # runs within --budget and the work cap; deterministic: no overlap runs; --json says where each limit came from
  [Check] -> [Rules] : match({Doc}) => {Hit}                   # and a dialect's rule pack (the dialect Core loaded)
  # check.RULE_GROUPS puts each rule in one group: global network concurrency traffic
  # ending entry (a dialect's rules: global). A group
  # the Doc's Kind turns off is not run, and never silent: the summary names its rules
  # (--all-rules runs them); an acknowledgement of an off rule is SGC003 unused
  [Rules] -> [Model] : facts({Doc}) => {Spine}                 # export rules read Systems, structure rules Structure
  [Rules]
      \-> [FlowRules]
      \-> [StateRules]      # SGC172 reads header_only, as Systems does
      \-> [TraceRules]      # SGC090: a run cut at a limit warns in spec (blocks export); the overlap hint stays info
      \-> [InvRules]
      \-> [ExportRules]     # SGC401, SGC402: only with --export (not in the playground)
      \-> [StructureRules]  # SGC176 unit-cycle, SGC177 large-unit: read Structure; in every check where shipped (not the playground)
  [TraceRules] -> [StateRules] : facts({Doc}) => {Spine}       # the shared static facts
}

# what leaves sigil: the build skeleton (the export edge) and review charts
[Publish] := {
  [Exporter] -> [Analyse] : ready({Doc}) => {Gate}             # #!spec, lint clean, check --export spec clean, at the document's limits and --limit
  [Exporter] -> [Hashes] : form({Doc}) => {Manifest}           # per system and per component interface/body hash
  # Hashes: no line numbers, order, spacing or top name; `#&` declarations in the
  # body hash; a dialect's attrs as written; system.json adds lines per component and flow.
  # round 7: a component's interface hash covers the shapes of the data its flows carry
  # (a field added to {X} rechecks every part that sends or takes {X}); comments stay body only
  # 0.6.9: a flow on from a `?>` guard's data subject is the guard caller's; a comment on a
  # shape's field joins its data's description (body hash, never the interface); an ack of a
  # unit's own finding (unit-cycle, large-unit) on its header is the unit's system's and its
  # face's, not its members'
  [Hashes] -> [Model] : systems({Doc}) => {Spine}
  [Hashes] -> [Analyse] : names({Name}) => {Catalog}           # check.CORE_NAMES, to read `# accepts:` lines
  # manifest: sigil (round 9: the version that wrote it; in no hash, so a new sigil marks
  # nothing), top, dialect {name, version}, systems {interface, body, components,
  # component_hashes, depends_on, parent}; a re-export deletes only files the old manifest lists
  # recheck: a system it depends on changed its interface, or one an enclosing system depends on
  # outside itself (a nested system's members make up its owner, so they use the owner's dependencies)
  [Exporter] -> [Delta] : compare({Manifest}) => {Changes}     # added removed rebuild recheck unchanged, renamed top
  # accepts: shared-writable-store — split by file: an export writes and deletes only the files its manifest names, a builder only its own
  [Exporter] -> |ExportDir| : read({Manifest}) => {Manifest}   # untrusted: names a slug check before any delete
  [Exporter] -> |ExportDir| : write({Files})                   # changed files only; delta.json, then manifest last; no lock: two exports into one DIR are not ordered
  (Builder) -> |ExportDir| : add({Files})                      # a builder's own files: an export never touches them
  [Mermaid] -> [Core] : parse({Text}) => {Doc}                 # any mode, no gate; an unlisted dialect kind → core shape
  [Spine] -> [Model] : systems({Doc}) => {Spine}               # --spine: a subgraph per system
  [Spine] -> [Mermaid] : chart({Doc}) => {Chart}
  [Spine] -> [Hashes] : slugs({Name}) => {Name}                # a subgraph per system, named by its folder slug
}

# drawing in cells: the kit and themes, the four views, the app, frames, highlight
# planned base: the vendored cure library (/home/ian/workspace/projects/cure); not built yet
[Present] := {
  # the live view: keys, pan, sim player, findings overlay; it puts the terminal in raw mode
  # and uses the kit directly too (the screen, the panels, the theme: not drawn)
  [App] -> |Source| : poll({Path}) => {Text}                   # reads FILE itself, again on each save (mtime, size)
  [App] -> [Views] : compose({Scene}) => {Drawing}
  [App] -> [Model] : run({Scene}) => {Trace}                   # and --structure's reading
  [App] -> [Analyse] : findings({Doc}) => {Findings}
  [Frames] -> |Source| : read({Path}) => {Text}                # frames draw reads FILE itself
  [Frames] -> [App] : compose({Scene}) => {Drawing}            # packed rows for pane, pi, playground: the app's layout pick
                                                               # it composes the tree, flow and run views and the kit itself too (not drawn)
  [Views] -> [Kit] : cells({Drawing}) => {Canvas}
  [Kit] -> [Analyse] : lint({Text}) => {Diagnostics}           # the lint summary under every drawing
  [Kit] -> [Themes] : theme({Name}) => {Palette}
  # the source as coloured runs, from the walk's own tokens (one token model with lint and
  # the views; highlight/ grammars follow it): every character in exactly one run, the runs
  # of a line joined give the line back, and text that does not lint still highlights
  # live editing: a line's runs depend only on that line and the carry state it starts in
  # (inside a `#&` body or a continued comment), so an edit re-highlights from the changed
  # line until the carry state matches the old one (--stream: the client does, asking for the
  # lines it needs; the server holds no document); IDE grammars in highlight/ are tested
  # against these runs (one corpus), so construct and an IDE colour a file alike
  [Highlight] -> [Core] : read({Text}) => {Statements}         # tokens with their columns, `#&` and `#%` lines included; a --stream {"dialect"} request loads through Core too (not drawn)
  [Highlight] -> [Themes] : theme({Name}) => {Palette}         # the theme's syntax roles (operator, keyword, modifier …)
  [Themes] -> |ThemeFiles| : read({Yaml}) => {Yaml}
  [Themes] -> [Core] : dialect({Name}) => {Hooks}             # a dialect's THEME (a theme name, or a YAML path beside the dialect): the default when no --theme is given
  (Author) ~> |ThemeFiles| : edit({Yaml})                      # themes/ beside the package, $SIGIL_THEME_PATH, or a PATH: a save, no answer
  # read once per run, whole: a theme applies only once it parses and resolves, so a save
  # caught half-written stops the run (exit 2), never draws half a theme
  |ThemeFiles| @inv atomic(theme)
  [Views]
      \-> [GraphView]
      \-> [TreeView]
      \-> [FlowView]       # reads GraphView's share rank
      \-> [RunView]
}
